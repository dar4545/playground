@@ -27,6 +27,33 @@ bool attachToGame = false;
 
 HWND hwnd;
 RECT cacheRect{ 100, 100, 730, 910 };
+// Set once the GUI window has been placed on the game's monitor (or moved by the user), so absolute
+// coordinates are only used as a fallback. Without this the window always opens at (100,100), which is
+// on the primary display, not necessarily on the display the game runs on. In multi-monitor setups this
+// gave capture tools (NVIDIA overlay PID capture) a second window of this process on the wrong display.
+static bool cacheRectPlaced = false;
+
+static void PlaceGuiRectOnGameMonitor()
+{
+    if (cacheRectPlaced) return;
+    HWND gameHwnd = FindWindowW(L"UnityWndClass", L"imasscprism");
+    if (gameHwnd == NULL) return;
+    HMONITOR monitor = MonitorFromWindow(gameHwnd, MONITOR_DEFAULTTONEAREST);
+    MONITORINFO mi{ sizeof(MONITORINFO) };
+    if (monitor == NULL || !GetMonitorInfoW(monitor, &mi)) return;
+    const LONG width = cacheRect.right - cacheRect.left;
+    const LONG height = cacheRect.bottom - cacheRect.top;
+    const LONG workWidth = mi.rcWork.right - mi.rcWork.left;
+    const LONG workHeight = mi.rcWork.bottom - mi.rcWork.top;
+    // Keep the window fully inside the game's monitor work area (portrait displays are narrow).
+    const LONG w = width < workWidth ? width : workWidth;
+    const LONG h = height < workHeight ? height : workHeight;
+    cacheRect.left = mi.rcWork.left + (workWidth - w) / 2;
+    cacheRect.top = mi.rcWork.top + (workHeight - h) / 2;
+    cacheRect.right = cacheRect.left + w;
+    cacheRect.bottom = cacheRect.top + h;
+    cacheRectPlaced = true;
+}
 
 void SetGuiDone(bool isDone) {
     guiDone = isDone;
@@ -78,6 +105,7 @@ void guimain()
